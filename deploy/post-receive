#!/bin/bash
#
# post-receive: deploys on `git push deploy main` (the same command and pattern as the other projects
# on this server). Installed at /opt/translate-deploy.git/hooks/post-receive.
# The code goes to /srv/translate; its .env and data/ (never in git) stay as they are.
#
set -e
# (the hook's own exit is the deploy's, not tee's: a failed one says so; audit 31)
set -o pipefail

APP_NAME="translate"
REPO_DIR="/opt/${APP_NAME}-deploy.git"
APP_DIR="/srv/${APP_NAME}"
LOG_FILE="${APP_DIR}/deploy.log"
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

{
    echo ""
    echo "========================================"
    echo " DEPLOY START: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "========================================"

    while read oldrev newrev refname; do
        LAST_REF="$refname"
    done

    if [ "$LAST_REF" = "refs/heads/main" ]; then
        echo ">>> Checking out the code to ${APP_DIR}..."
        git --work-tree="${APP_DIR}" --git-dir="${REPO_DIR}" checkout -f main
        cd "${APP_DIR}"

        if [ ! -f .env ]; then
            echo ">>> STOP: ${APP_DIR}/.env is missing (see .env.example)."
            exit 1
        fi

        # the container's user (uid 1000) writes data/ (the database): a folder Docker creates by
        # itself would belong to root
        echo ">>> The data folder..."
        mkdir -p data
        chown 1000:1000 data

        echo ">>> Building (with the tests) and restarting the container..."
        # (--pull: the base image's security updates come with every deploy; audit 31)
        docker compose build --pull
        docker compose up -d --remove-orphans

        echo ">>> Waiting for the health check..."
        for i in $(seq 1 30); do
            STATE=$(docker inspect -f '{{.State.Health.Status}}' "${APP_NAME}" 2>/dev/null || echo none)
            [ "$STATE" = "healthy" ] && break
            sleep 2
        done
        echo "    health: ${STATE}"

        echo ">>> Cleaning up old Docker images..."
        docker image prune -f 2>/dev/null || true
        docker builder prune -af --filter until=72h 2>/dev/null || true

        echo "========================================"
        echo " DEPLOY COMPLETE: $(date '+%Y-%m-%d %H:%M:%S') (health: ${STATE})"
        echo "========================================"
        [ "$STATE" = "healthy" ] || exit 1
    else
        echo ">>> Branch $LAST_REF ignored: only main deploys."
    fi

} 2>&1 | tee -a "${LOG_FILE}" || {
    echo ">>> DEPLOY FAILED: see above (the app that was running keeps running unless it said unhealthy)" | tee -a "${LOG_FILE}"
    exit 1
}
