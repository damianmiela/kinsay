# Copy to .env and fill in. Never commit .env.
ADMIN_PASSWORD=
# 32 characters or more, random (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
SESSION_SECRET=
# The new app's own Soniox project key (without it: no captions)
SONIOX_API_KEY=
# Soniox streams this app may hold at once (Soniox counts 10 per organization; the wedding's own captions
# need theirs only on the wedding day, when the other apps are switched off)
SONIOX_STREAMS=10
# What one stream (one language) costs per hour of audio, in euros: the credits are charged at this price
PRICE_EUR_PER_STREAM_HOUR=
# Defaults for the admin's settings (euros a month; 0: no limit)
MONTHLY_LIMIT_EUR=5
GLOBAL_LIMIT_EUR=20
PORT=3300
# Behind Nginx Proxy Manager on the VPS: true
# Who is responsible for the data, shown on /privacy
CONTACT_NAME=
CONTACT_EMAIL=
TRUST_PROXY=false
# Behind a proxy that shares a Docker network with other containers: only its container's X-Forwarded-For
# counts (its name, e.g. proxy-npm-1; docker-compose.yml sets both on the server)
TRUST_PROXY_FROM=
# This app's own address (the links in emails, Google's way back)
PUBLIC_URL=
# Sign-in links by email through Brevo (both needed; else no email sign-in)
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Translate
# Google sign-in (an OAuth client of type "Web application"; its redirect: PUBLIC_URL/api/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
