<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kinsay's desktop app (2026-11-12, from the wedding app's small subtitles app): a window of
       Windows' own browser engine (WebView2) round translate.dendigital.de/window, and this computer's
       sound from Windows' audio loopback. .NET Framework 4.8 is part of Windows 10 and 11: nothing else
       to install. Build: dotnet build -c Release (desktop\win); pack: node desktop\pack-win.mjs -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Kinsay</AssemblyName>
    <RootNamespace>TranslateApp</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Kinsay's logo (scripts/make-icons.mjs): the exe's icon, the taskbar's and the window's -->
    <ApplicationIcon>kinsay.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <!-- One file to download (Damian, 2026-11-12): the libraries go inside Kinsay.exe as resources
       (Program.cs loads them from there; WebView2's native loader is unpacked to the app's own folder
       on first start). Not the WPF part of WebView2: the app is WinForms. -->
  <Target Name="EmbedLibraries" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And '%(ReferenceCopyLocalPaths.Filename)' != 'Microsoft.Web.WebView2.Wpf' And '%(ReferenceCopyLocalPaths.Filename)' != 'WebView2Loader'">
        <LogicalName>%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4258.31\runtimes\win-x64\native\WebView2Loader.dll">
        <LogicalName>native.WebView2Loader.dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
  </ItemGroup>
</Project>
